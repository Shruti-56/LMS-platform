# =========================
# Database
# =========================
DATABASE_URL="mysql://root:your_password@localhost:3306/DataUniverse"

# =========================
# JWT Authentication
# =========================
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# =========================
# Server
# =========================
PORT=3001
NODE_ENV=development

# =========================
# AWS S3 (for video storage)
# =========================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-bucket-name

# =========================
# Razorpay Payment Gateway
# =========================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# =========================
# Email (SMTP) - Required for assignment/review emails
# =========================
# Without SMTP_USER and SMTP_PASS, no emails are sent. For Gmail use an App Password.
# If you get ENETUNREACH/connection errors: use SMTP_HOST=smtp.gmail.com (not an IP).
# If port 587 is blocked on your network, try port 465 with SMTP_SECURE=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=DataUniverse <your_email@gmail.com>
# Instructor gets submission emails only if the student has an assigned instructor (Admin → Students).

# =========================
# Frontend URL
# =========================
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# =========================
# Live lecture reminders (mail 10 min before scheduled time)
# =========================
# Server uses this for "10 min before" reminder window. Set to your institute timezone.
TZ=Asia/Kolkata
